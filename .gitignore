# ==============================================================================
# HireZone Root .gitignore
# ==============================================================================

# Node dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment and sensitive keys
.env
.env.*
!.env.example
*.env.local
*.env.production
*.env.development

# Production builds
dist/
dist-ssr/
build/
*/dist/

# Candidate uploads and dynamic media
Server/uploads/resumes/*
!Server/uploads/resumes/.gitkeep
uploads/resumes/*
!uploads/resumes/.gitkeep

# IDE, OS, and Editor files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vite cache & temp
.vite/
.vite-temp/
*/.vite/
*/.vite-temp/
