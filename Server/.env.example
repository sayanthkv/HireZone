# HireZone Server Environment Configuration

# Server Port & Allowed Client URL
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hirezone?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Transactional Email Alerts (Nodemailer / SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Google Gemini AI (ATS Resume Parsing & Skill Analysis)
GEMINI_API_KEY=your_gemini_api_key_here
